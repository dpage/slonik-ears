# Build output
/bin/
/dist/
# Anchored: an unanchored "ears-server" would also match the cmd/ears-server
# source directory, which is a surprising way to lose your program.
/ears-server
/ears-listener

# Front-end build output (rebuilt by `make web`; the placeholder is kept so
# that `go build` works in a fresh checkout)
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/

# Runtime data
/data/
*.jsonl
*.wav
!/testdata/sample.wav

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Browser smoke test output
/web/e2e/output/
