[Unit]
Description=Slonik Ears room listener
After=pipewire.service pipewire-pulse.service

[Service]
ExecStart=/usr/bin/ears-listener --config /etc/slonik-ears/listener.yaml
EnvironmentFile=-%h/.config/slonik-ears/listener.env
# Not "slonik-ears": systemd would see ~/.config/slonik-ears (where the token
# file lives) and symlink the state directory to it, as if migrating from
# systemd 253, putting transcripts beside the token.
StateDirectory=slonik-ears-listener
WorkingDirectory=%S/slonik-ears-listener
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
